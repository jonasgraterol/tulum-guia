---
interface Props {
  id: string;
  title: string;
  description: string;
  accentColor: string;
  count?: number;
}

const { id, title, description, accentColor, count = 3 } = Astro.props;

const gridClass = count === 1
  ? 'grid grid-cols-1 gap-6 max-w-sm mx-auto'
  : count === 2
    ? 'grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl mx-auto'
    : 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6';
---

<section id={id} class="py-16 md:py-20 px-6">
  <div class="max-w-5xl mx-auto">
    <div class="text-center mb-12">
      <div class="inline-block w-12 h-1 rounded-full mb-4" style={`background-color: ${accentColor}`}></div>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-bark mb-3">
        {title}
      </h2>
      <p class="text-bark/60 text-lg max-w-xl mx-auto">
        {description}
      </p>
    </div>
    <div class={gridClass}>
      <slot />
    </div>
  </div>
</section>
