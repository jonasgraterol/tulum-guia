---
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isEs = locale === 'es';
---

<section id="jaguar" class="py-16 md:py-20 px-6">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-12">
      <div class="inline-block w-12 h-1 rounded-full mb-4 bg-honey"></div>
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-bark mb-3">
        🐆 {isEs ? 'Guía de Acceso al Parque Jaguar' : 'Jaguar Park Access Guide'}
      </h2>
      <p class="text-bark/60 text-lg max-w-xl mx-auto">
        {isEs ? 'Todo lo que necesitas saber para acceder a las playas de Tulum' : 'Everything you need to know to access Tulum\'s beaches'}
      </p>
    </div>

    <div class="space-y-6">
      <!-- Fecha de actualización -->
      <div class="text-center">
        <span class="inline-flex items-center gap-2 bg-honey/10 border border-honey/30 rounded-full px-4 py-2 text-sm text-bark/70">
          📅 {isEs ? 'Información actualizada al 04 de diciembre del 2025' : 'Information updated as of December 04, 2025'}
        </span>
      </div>

      <!-- Horarios y Costos -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-sand/50">
        <h3 class="font-heading text-xl font-bold text-bark mb-4">
          🗓 {isEs ? 'Horarios y Costos (Lunes a Sábado)' : 'Hours & Costs (Monday to Saturday)'}
        </h3>
        <div class="space-y-3">
          <div class="bg-jungle/5 rounded-xl p-4">
            <p class="font-medium text-bark mb-2">{isEs ? 'Acceso Completo (incluye ruinas, museo y miradores)' : 'Full Access (includes ruins, museum & viewpoints)'}</p>
            <div class="flex flex-wrap gap-4 text-sm text-bark/70">
              <span>🇲🇽 {isEs ? 'Nacionales' : 'Nationals'}: <strong class="text-bark">$300 MXN</strong></span>
              <span>🌍 {isEs ? 'Extranjeros' : 'Foreigners'}: <strong class="text-bark">$400 MXN</strong></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Acceso Gratuito -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-sand/50">
        <h3 class="font-heading text-xl font-bold text-bark mb-4">
          🚶‍♀️ {isEs ? 'Acceso Gratuito (Lunes a Domingo)' : 'Free Access (Monday to Sunday)'}
        </h3>
        <p class="text-sm text-bark/70 mb-3">
          {isEs ? 'Disponible caminando, en bicicleta o transporte eléctrico interno.' : 'Available on foot, by bicycle, or internal electric transport.'}
        </p>
        <div class="mb-3">
          <p class="text-sm font-medium text-bark mb-2">{isEs ? 'Playas incluidas:' : 'Beaches included:'}</p>
          <div class="flex flex-wrap gap-2">
            {['Playa Mangle', 'Playa Maya Paraíso', 'Playa Pescadores', 'Playa Santa Fe', 'Playa Maya'].map(playa => (
              <span class="bg-cenote/10 text-cenote text-xs px-3 py-1 rounded-full font-medium">{playa}</span>
            ))}
          </div>
        </div>
        <div class="bg-honey/10 border border-honey/30 rounded-xl px-4 py-3">
          <p class="text-xs text-bark/70">
            ⚠️ {isEs ? 'Este acceso NO incluye las ruinas. Si desean entrar luego: $300 MXN nacionales / $400 MXN extranjeros' : 'This access does NOT include the ruins. If you want to enter later: $300 MXN nationals / $400 MXN foreigners'}
          </p>
        </div>
      </div>

      <!-- Clubes de Playa -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-sand/50">
        <h3 class="font-heading text-xl font-bold text-bark mb-4">
          🏖 {isEs ? 'Acceso Solo a Clubes de Playa' : 'Beach Club Access Only'}
        </h3>
        <p class="text-sm text-bark/70 mb-4">
          {isEs ? 'Si el plan es solo ir a la playa sin comprar el acceso completo al parque:' : 'If you just want to go to the beach without buying full park access:'}
        </p>
        <div class="bg-sand/50 rounded-xl p-4">
          <ul class="text-sm text-bark/70 space-y-2">
            <li>• {isEs ? 'Se requiere reserva en un club de playa' : 'Reservation at a beach club is required'}</li>
            <li>• {isEs ? 'Pago en caseta' : 'Gate fee'}: 🇲🇽 $60 MXN {isEs ? 'nacionales' : 'nationals'} &nbsp;/&nbsp; 🌍 $120 MXN {isEs ? 'extranjeros' : 'foreigners'}</li>
            <li>• {isEs ? 'Se puede entrar en cualquier medio de transporte, incluso en auto' : 'You can enter by any means of transport, including by car'}</li>
            <li>• {isEs ? 'El auto se puede estacionar directamente en el club de playa elegido' : 'You can park your car directly at the chosen beach club'}</li>
          </ul>
        </div>
      </div>

      <!-- Accesos Recomendados -->
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-sand/50">
        <h3 class="font-heading text-xl font-bold text-bark mb-4">
          🚗 {isEs ? 'Accesos Recomendados' : 'Recommended Entrances'}
        </h3>
        <div class="space-y-3">
          <div class="flex items-start gap-3">
            <span class="bg-jungle/10 text-jungle text-xs px-2 py-1 rounded-full font-medium flex-shrink-0 mt-0.5">
              {isEs ? 'Con auto' : 'By car'}
            </span>
            <div>
              <p class="text-sm font-medium text-bark">{isEs ? 'Acceso Centro' : 'Center Access'}</p>
              <p class="text-xs text-bark/60">📍 {isEs ? 'Frente a la glorieta de las ruinas (Carretera Tulum-Cancún). Estacionamiento gratuito. Recomendado si deseas entrar a las ruinas' : 'In front of the ruins roundabout (Tulum-Cancún Highway). Free parking. Recommended if you want to visit the ruins'}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="bg-jungle/10 text-jungle text-xs px-2 py-1 rounded-full font-medium flex-shrink-0 mt-0.5">
              {isEs ? 'Sin auto' : 'No car'}
            </span>
            <div>
              <p class="text-sm font-medium text-bark">{isEs ? 'Acceso Sur' : 'South Access'}</p>
              <p class="text-xs text-bark/60">📍 {isEs ? 'Avenida Cobá hacia la zona costera. Ideal para caminar, bici o transporte local' : 'Cobá Avenue toward the coastal zone. Ideal for walking, biking, or local transport'}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <span class="bg-jungle/10 text-jungle text-xs px-2 py-1 rounded-full font-medium flex-shrink-0 mt-0.5">
              {isEs ? 'Club de playa' : 'Beach club'}
            </span>
            <div>
              <p class="text-sm font-medium text-bark">{isEs ? 'Acceso Sur' : 'South Access'}</p>
              <p class="text-xs text-bark/60">{isEs ? 'La mejor opción con o sin carro' : 'Best option with or without a car'}</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Permitido / No Permitido -->
      <div class="grid md:grid-cols-2 gap-6">
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-sand/50">
          <h3 class="font-heading text-lg font-bold text-jungle mb-3">
            ✅ {isEs ? 'Permitido' : 'Allowed'}
          </h3>
          <ul class="text-sm text-bark/70 space-y-2">
            <li>• {isEs ? 'Alimentos y bebidas no alcohólicas' : 'Food and non-alcoholic drinks'}</li>
            <li>• {isEs ? 'Termos y cantimploras' : 'Thermoses and water bottles'}</li>
            <li>• {isEs ? 'Cartón y latas' : 'Cartons and cans'}</li>
          </ul>
        </div>
        <div class="bg-white rounded-2xl p-6 shadow-sm border border-sand/50">
          <h3 class="font-heading text-lg font-bold text-park mb-3">
            ❌ {isEs ? 'No Permitido' : 'Not Allowed'}
          </h3>
          <ul class="text-sm text-bark/70 space-y-2">
            <li>• {isEs ? 'Plástico de un solo uso' : 'Single-use plastics'}</li>
            <li>• {isEs ? 'Mascotas' : 'Pets'}</li>
            <li>• {isEs ? 'Bebidas alcohólicas' : 'Alcoholic beverages'}</li>
            <li>• {isEs ? 'Cigarros' : 'Cigarettes'}</li>
            <li>• {isEs ? 'Bocinas / música alta' : 'Speakers / loud music'}</li>
          </ul>
        </div>
      </div>

      <!-- Acceso Libre Hoteles -->
      <div class="bg-jungle/5 rounded-2xl p-6 border border-jungle/10">
        <h3 class="font-heading text-xl font-bold text-bark mb-3">
          🏖 {isEs ? 'Acceso Libre a Hoteles y Beach Clubs' : 'Free Access to Hotels & Beach Clubs'}
        </h3>
        <p class="text-sm text-bark/70 mb-4">
          {isEs ? '15 hoteles y beach clubs permiten el acceso a la playa sin costo de entrada ni consumo mínimo. Este acceso es independiente del Parque Jaguar.' : '15 hotels and beach clubs allow beach access with no entrance fee or minimum spend. This access is independent of Jaguar Park.'}
        </p>
        <div class="mb-3">
          <p class="text-sm font-medium text-bark mb-2">{isEs ? 'Hoteles:' : 'Hotels:'}</p>
          <div class="flex flex-wrap gap-1.5">
            {['Ana y José', 'Casa Gitano', 'Casa Violeta', 'Ahau', 'Delek', 'Alaya', 'Coco Unlimited', 'Hotel Nest', 'Hotel Sana', 'Dos Ceibas', 'Villa Alquimia', 'Papaya Playa Project', 'Hotel Maxanab'].map(hotel => (
              <span class="bg-white text-bark/70 text-xs px-2.5 py-1 rounded-full border border-sand/50">{hotel}</span>
            ))}
          </div>
        </div>
        <div>
          <p class="text-sm font-medium text-bark mb-2">Beach Clubs:</p>
          <div class="flex flex-wrap gap-1.5">
            {['La Eufemia', 'Fara Fara', 'Blue Venado'].map(club => (
              <span class="bg-white text-bark/70 text-xs px-2.5 py-1 rounded-full border border-sand/50">{club}</span>
            ))}
          </div>
        </div>
        <div class="mt-3 bg-honey/10 border border-honey/30 rounded-xl px-4 py-3">
          <p class="text-xs text-bark/70">
            ✔️ {isEs ? 'El acceso es únicamente a la playa. Servicios internos (camastros, toallas, restaurantes) tienen costo adicional.' : 'Access is to the beach only. Internal services (loungers, towels, restaurants) have an additional cost.'}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
